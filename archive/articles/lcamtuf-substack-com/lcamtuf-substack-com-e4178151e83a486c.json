ubstack-post-media.s3.amazonaws.com/public/images/b2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:971,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:977300,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:false,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://blog.coredump.cx/i/215699484?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!u32k!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg 424w, https://substackcdn.com/image/fetch/$s_!u32k!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg 848w, https://substackcdn.com/image/fetch/$s_!u32k!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!u32k!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fb2033448-d84c-4a4d-91d7-c5af047f8e94_2000x1334.jpeg 1456w\" sizes=\"100vw\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-GK1x3M\"></button><button tabindex=\"0\" type=\"button\" class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-GK1x3M\"></button></div></div></div></a><figcaption class=\"image-caption\"><em>Full-color illustrations.</em></figcaption></figure></div><p><em>The Secret Life of Circuits</em> is available from all the usual places, including <a href=\"https://www.barnesandnoble.com/w/the-secret-life-of-circuits-michal-zalewski/1149922689\">Barnes &amp; Noble</a> and <a href=\"https://www.amazon.com/dp/1718504802\">Amazon</a> (plustheir regional sites in <a href=\"https://www.amazon.de/dp/1718504802\">Germany</a>, <a href=\"https://www.amazon.fr/dp/1718504802\">France</a>, <a href=\"https://www.amazon.pl/dp/1718504802\">Poland</a>, <a href=\"https://www.amazon.es/dp/1718504802\">Spain</a>, <a href=\"https://www.amazon.nl/dp/1718504802\">Netherlands</a>, <a href=\"https://www.amazon.se/dp/1718504802\">Sweden</a>, <a href=\"https://www.amazon.it/dp/1718504802\">Italy</a>, <a href=\"https://www.amazon.co.uk/dp/1718504802\">United Kingdom</a>, and <a href=\"https://www.amazon.ca/dp/1718504802\">Canada</a>):</p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://www.amazon.com/dp/1718504802&quot;,&quot;text&quot;:&quot;Order on Amazon&quot;,&quot;action&quot;:null,&quot;class&quot;:null}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary\" href=\"https://www.amazon.com/dp/1718504802\"><span>Order on Amazon</span></a></p><p>You can also purchase the book directly from the publisher; these copies come with complementary DRM-free ebook formats:</p><p class=\"button-wrapper\" data-attrs=\"{&quot;url&quot;:&quot;https://nostarch.com/secret-life-of-circuits&quot;,&quot;text&quot;:&quot;No Starch order page&quot;,&quot;action&quot;:null,&quot;class&quot;:null}\" data-component-name=\"ButtonCreateButton\"><a class=\"button primary\" href=\"https://nostarch.com/secret-life-of-circuits\"><span>No Starch order page</span></a></p><p>The book is the reference I wish I had when first learning the craft. It gives real answers but doesn&#8217;t demand a year of calculus beforehand. It explains how to come up with your own designs, not how to copy other people&#8217;s work. And it focuses on modern problem-solving, not on circuit archaeology.</p><p>If you&#8217;re a regular to this blog, you know my style. <em>The Secret Life of Circuits</em> takes a similar approach, with the added benefit of careful design and a skilled editor. It&#8217;s also pretty: it&#8217;s a premium-size, full-color hardcover with nearly 300 diagrams and illustrations crafted specifically for that occasion.</p><p>You can check out the sample chapter <a href=\"https://nostarch.com/download/samples/secret-life-of-circuits_chapter-9.pdf\">here</a>, or get a sense of the approach from the following blog posts:</p><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;eae53133-5804-45e3-b6f1-21068626f9c3&quot;,&quot;caption&quot;:&quot;A recurring theme of this Substack are my attempts to build out an accessible curriculum for hobby electronics. The target audience are folks who want real answers, but who aren&#8217;t keen on academic textbooks brimming with obtuse jargon and advanced calculus. I&#8217;m particularly fond of the following foundational articles:&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;But good sir, what is electricity?&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:92541588,&quot;name&quot;:&quot;lcamtuf&quot;,&quot;bio&quot;:&quot;Recommended by 4 out of 5 dentists.&quot;,&quot;photo_url&quot;:&quot;https://bucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com/public/images/160026b1-f333-4244-b8dc-5ca8c437a0b4_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:null}],&quot;post_date&quot;:&quot;2025-02-23T05:55:49.507Z&quot;,&quot;cover_image&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/970ffc9c-bf20-40fc-b235-5483a4a851a0_736x309.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://blog.coredump.cx/p/but-good-sir-what-is-electricity&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:157690720,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:125,&quot;comment_count&quot;:5,&quot;publication_id&quot;:1030211,&quot;publication_name&quot;:&quot;lcamtuf&#8217;s thing&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!WvGP!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F57b73d90-d717-4de9-bfb7-30a0f2913607_400x400.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;bd6d4da2-552f-4feb-a405-47dd7360184c&quot;,&quot;caption&quot;:&quot;The diode might be the most neglected component in the electronics curriculum today. Pages upon pages have been written about the mechanics of resistors, capacitors, and inductors; on this blog alone, we covered the components&#8217; fundamental equations, the model of&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;Things you can do with diodes&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:92541588,&quot;name&quot;:&quot;lcamtuf&quot;,&quot;bio&quot;:&quot;Recommended by 4 out of 5 dentists.&quot;,&quot;photo_url&quot;:&quot;https://bucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com/public/images/160026b1-f333-4244-b8dc-5ca8c437a0b4_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:null}],&quot;post_date&quot;:&quot;2025-11-02T19:39:54.712Z&quot;,&quot;cover_image&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/03297fe4-2aef-4b79-9d7b-496d9b7978e7_1186x1027.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://blog.coredump.cx/p/things-you-can-do-with-diodes&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:177769958,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:38,&quot;comment_count&quot;:4,&quot;publication_id&quot;:1030211,&quot;publication_name&quot;:&quot;lcamtuf&#8217;s thing&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!WvGP!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F57b73d90-d717-4de9-bfb7-30a0f2913607_400x400.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;686eff65-60a0-4582-88cc-fd89f3fac36f&quot;,&quot;caption&quot;:&quot;Hello! The blog you&#8217;re trying to reach is currently unavailable. I am Skippy, your friendly blog assistant. How can I help you today?&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;Negative resistance&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:92541588,&quot;name&quot;:&quot;lcamtuf&quot;,&quot;bio&quot;:&quot;Recommended by 4 out of 5 dentists.&quot;,&quot;photo_url&quot;:&quot;https://bucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com/public/images/160026b1-f333-4244-b8dc-5ca8c437a0b4_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:null}],&quot;post_date&quot;:&quot;2026-07-23T22:55:51.316Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/$s_!4eW2!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F075e5b09-15f4-44a3-be82-7af65fa9478a_2450x1232.jpeg&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://blog.coredump.cx/p/negative-resistance&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:205698096,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:11,&quot;comment_count&quot;:1,&quot;publication_id&quot;:1030211,&quot;publication_name&quot;:&quot;lcamtuf&#8217;s thing&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!WvGP!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F57b73d90-d717-4de9-bfb7-30a0f2913607_400x400.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><div class=\"digest-post-embed\" data-attrs=\"{&quot;nodeId&quot;:&quot;18b55851-2222-4533-b11b-4f99aa214595&quot;,&quot;caption&quot;:&quot;In one of the earlier articles, I remarked that microcontrollers are eating the world. Even for rudimentary tasks, such as blinking a LED, a microcontroller is now cheaper and simpler to use than an oscillator circuit built with discrete components or implemented using the once-ubiquitous 555 timer chip.&quot;,&quot;cta&quot;:null,&quot;showBylines&quot;:true,&quot;showDescription&quot;:true,&quot;showImage&quot;:true,&quot;size&quot;:&quot;sm&quot;,&quot;isEditorNode&quot;:true,&quot;title&quot;:&quot;DACs and ADCs, or there and back again&quot;,&quot;publishedBylines&quot;:[{&quot;id&quot;:92541588,&quot;name&quot;:&quot;lcamtuf&quot;,&quot;bio&quot;:&quot;Recommended by 4 out of 5 dentists.&quot;,&quot;photo_url&quot;:&quot;https://bucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com/public/images/160026b1-f333-4244-b8dc-5ca8c437a0b4_400x400.jpeg&quot;,&quot;is_guest&quot;:false,&quot;bestseller_tier&quot;:null}],&quot;post_date&quot;:&quot;2024-02-19T01:52:48.238Z&quot;,&quot;cover_image&quot;:&quot;https://substackcdn.com/image/fetch/f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F958b8e14-9ff8-40a9-a887-26f991f82ef1_2813x1875.png&quot;,&quot;cover_image_alt&quot;:null,&quot;canonical_url&quot;:&quot;https://blog.coredump.cx/p/dacs-and-adcs-or-there-and-back-again&quot;,&quot;section_name&quot;:null,&quot;video_upload_id&quot;:null,&quot;id&quot;:141565814,&quot;type&quot;:&quot;newsletter&quot;,&quot;reaction_count&quot;:16,&quot;comment_count&quot;:7,&quot;publication_id&quot;:1030211,&quot;publication_name&quot;:&quot;lcamtuf&#8217;s thing&quot;,&quot;publication_logo_url&quot;:&quot;https://substackcdn.com/image/fetch/$s_!WvGP!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fbucketeer-e05bbc84-baa3-437e-9518-adb32be77984.s3.amazonaws.com%2Fpublic%2Fimages%2F57b73d90-d717-4de9-bfb7-30a0f2913607_400x400.png&quot;,&quot;belowTheFold&quot;:true,&quot;youtube_url&quot;:null,&quot;show_links&quot;:null,&quot;feed_url&quot;:null}\"></div><p>If you&#8217;re still on the fence, here are some endorsements from fellow enthusiasts:</p><blockquote><p><em>&#8220;Reading this gem of a book is like exploring the component drawers at RadioShack, with an expert on hand to explain what each part does and how to design electronics with them. There is no better introduction.&#8221;</em>  &#8212; Travis Goodspeed, author of &#8220;Microcontroller Exploits&#8221;</p><p><em>&#8220;The Secret Life of Circuits is neither a textbook nor a trivial introduction; it&#8217;s a balanced mix of practical knowledge, math, and conceptual explanations free of clich&#233;d analogies.&#8221;</em> &#8212; Eric Schlaepfer, co-author of &#8220;Open Circuits&#8221;</p><p><em>&#8220;A complete tour of electronics from low-level physics to modern microcontrollers, along the way providing hands-on experiments and insights that make even complex topics like impedance matching and antennas feel intuitive.&#8221;</em> &#8212; Colin O&#8217;flynn, co-author of &#8220;The Hardware Hacking Handbook&#8221;, assistant professor of electrical and computer engineering</p><p><em>&#8220;Michal&#8217;s book bridges the dif cult chasm between theory and practice with beautiful illustrations and an easy-to-understand framing of the physics of electronics.&#8221;</em> &#8212; Chris Gammell, co-host of &#8220;The Amp Hour&#8221;</p></blockquote><p>I also have the first endorsement from Hacker News: <em>&#8220;I looked at the sample chapter, the fonts and layout are visually repulsive.&#8221;</em> So, you can&#8217;t go wrong.</p><p>As always, the book and the blog are:</p><div class=\"captioned-image-container\"><figure><div class=\"image-link image2\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!Fzmg!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 424w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 848w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 1272w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 1456w\" sizes=\"auto, 100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!Fzmg!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png\" width=\"256\" height=\"70\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:70,&quot;width&quot;:256,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:5925,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/png&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://blog.coredump.cx/i/215699484?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!Fzmg!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 424w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 848w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 1272w, https://substackcdn.com/image/fetch/$s_!Fzmg!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F5db04ea5-f2ae-41c0-9baf-693e04709fdb_256x70.png 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div></div></div></div></figure></div>",
