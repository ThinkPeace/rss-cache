  "content_html": "<div class=\"PluginCard-main\">\n    <div class=\"PluginCard-content\">\n      <h3>Kern On</h3>\n              <p class=\"PluginCard-subtitle\">Tim Ahrens</p>\n                    <div class=\"PluginCard-text\"><p><em>Kern on</em> is a revolutionary kerning assistant that helps you cut down the time you spend kerning to just a few minutes. It takes care of kerning groups <em>and</em> your kerning. All it needs is a few kern pairs from you, then the plug-in ‘kerns on for you’.</p></div>\n          </div>\n\n          <div class=\"PluginCard-mainImage\">\n          \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n          <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/8ea59a3963-1785165125/ko-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" height=\"560\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"720\" />\n    </picture>\n        </div>\n      </div>\n\n      <div class=\"PluginCard-cta\">\n              <div class=\"PluginCard-ctaImage\">\n            \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"250px\" data-srcset=\"https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-2560x-q80.webp 1280w\" height=\"250\" media=\"all\" type=\"image/webp\" width=\"250\">\n          <source\n            data-sizes=\"250px\" data-srcset=\"https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-320x-q80.png 160w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-640x-q80.png 320w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-1280x-q80.png 640w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-1920x-q80.png 960w, https://glyphsapp.com/media/pages/home/57a8feabed-1785165125/ko-logo-2560x-q80.png 1280w\" height=\"250\" media=\"all\" type=\"image/png\" width=\"250\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"250px\" height=\"250\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"250\" />\n    </picture>\n          </div>\n      \n      <a href=\"https://kern-on.com\" class=\"PluginCard-ctaLink\">\n                  <span>199€</span>\n                <span>→ Get Kern On</span>\n      </a>\n    </div>\n  </article>\n      </div>\n          <div class=\"Carousel-slide\" data-carousel-slide data-status=\"Slide 2 of 6\">\n        <article class=\"PluginCard PluginCard--right PluginCard--orange\">\n  <div class=\"PluginCard-main\">\n    <div class=\"PluginCard-content\">\n      <h3>Show Stem Thickness</h3>\n              <p class=\"PluginCard-subtitle\">Rafał Buchner</p>\n                    <div class=\"PluginCard-text\"><p><em>View → Show Stem Thickness</em> gives you a continuous measure of the stems, right at your finger tips.</p></div>\n          </div>\n\n          <div class=\"PluginCard-mainImage\">\n          \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n          <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/5f8c3aafe7-1785165125/showstem-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" height=\"560\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"720\" />\n    </picture>\n        </div>\n      </div>\n\n      <div class=\"PluginCard-cta\">\n      \n      <a href=\"https://github.com/RafalBuchner/StemThickness\" class=\"PluginCard-ctaLink\">\n                  <span>Free</span>\n                <span>→ Get Plugin</span>\n      </a>\n    </div>\n  </article>\n      </div>\n          <div class=\"Carousel-slide\" data-carousel-slide data-status=\"Slide 3 of 6\">\n        <article class=\"PluginCard PluginCard--right PluginCard--cyan\">\n  <div class=\"PluginCard-main\">\n    <div class=\"PluginCard-content\">\n      <h3>Speed Punk</h3>\n              <p class=\"PluginCard-subtitle\">Yanone</p>\n                    <div class=\"PluginCard-text\"><p><em>Speed Punk</em> is a learning tool. It teaches you to better understand the nature of Bézier curves and their curvature, the technical basis of digital type design.</p></div>\n          </div>\n\n          <div class=\"PluginCard-mainImage\">\n          \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n          <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/c1429c89d0-1785165125/speedpunk-img-2560x-q80.webp 1280w\" height=\"560\" media=\"all\" type=\"image/webp\" width=\"720\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" height=\"560\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"720\" />\n    </picture>\n        </div>\n      </div>\n\n      <div class=\"PluginCard-cta\">\n              <div class=\"PluginCard-ctaImage\">\n            \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"250px\" data-srcset=\"https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-2560x-q80.webp 1280w\" height=\"250\" media=\"all\" type=\"image/webp\" width=\"250\">\n          <source\n            data-sizes=\"250px\" data-srcset=\"https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-320x-q80.png 160w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-640x-q80.png 320w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-1280x-q80.png 640w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-1920x-q80.png 960w, https://glyphsapp.com/media/pages/home/4b281bad1e-1785165125/speedpunk-logo-2560x-q80.png 1280w\" height=\"250\" media=\"all\" type=\"image/png\" width=\"250\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"250px\" height=\"250\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"250\" />\n    </picture>\n          </div>\n      \n      <a href=\"https://github.com/yanone/speedpunk\" class=\"PluginCard-ctaLink\">\n                  <span>Free</span>\n                <span>→ Get Speed Punk</span>\n      </a>\n    </div>\n  </article>\n      </div>\n          <div class=\"Carousel-slide\" data-carousel-slide data-status=\"Slide 4 of 6\">\n        <article class=\"PluginCard PluginCard--right PluginCard--yellow\">\n  <div class=\"PluginCard-main\">\n    <div class=\"PluginCard-content\">\n      <h3>Hellbox</h3>\n              <p class=\"PluginCard-subtitle\">Jake Fleming</p>\n                    <div class=\"PluginCard-text\"><p>Hellbox is a font proofing app for the Mac. It watches your Glyphs file and rebuilds real PDF proofs the moment you save: spacing strings, waterfalls, glyph sets, diacritics, and your own layouts. Double-click any glyph in a proof and it opens in an Edit view in Glyphs, so you go from spotting a problem to fixing it in one click.</p></div>\n          </div>\n\n          <div class=\"PluginCard-mainImage\">\n          \n    <picture\n      class=\"js-only\">\n                <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-320x-q80.webp 160w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-640x-q80.webp 320w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-1280x-q80.webp 640w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-1920x-q80.webp 960w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-2560x-q80.webp 1280w\" height=\"1120\" media=\"all\" type=\"image/webp\" width=\"1440\">\n          <source\n            data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" data-srcset=\"https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-320x-q80.png 160w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-640x-q80.png 320w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-1280x-q80.png 640w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-1920x-q80.png 960w, https://glyphsapp.com/media/pages/home/e41cae0c09-1787248529/hellbox-glyphs-discover-your-tribe-2560x-q80.png 1280w\" height=\"1120\" media=\"all\" type=\"image/png\" width=\"1440\">\n            <img\n        alt=\"\" data-lazyload data-sizes=\"(min-width: 1440px) 750px, (min-width: 800px) 45vw, 90vw\" height=\"1120\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"1440\" />\n    </picture>\n        </div>\n      </div>\n\n      <div class=\"PluginCard-cta\">\n              <div class=\"PluginCard-ctaImage\">\n            \n    <img\n      alt=\"\" data-lazyload data-src=\"https://glyphsapp.com/media/pages/home/c5f503282d-1787248529/hellbox-logo.svg\" height=\"250\" src=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNkYAAAAAYAAjCB0C8AAAAASUVORK5CYII=\" width=\"254\" />\n          </div>\n      \n      <a href=\"https://hellbox.com/\" class=\"PluginCard-ctaLink\">\n                  <span>100$<br>(students&nbsp;50$)</s