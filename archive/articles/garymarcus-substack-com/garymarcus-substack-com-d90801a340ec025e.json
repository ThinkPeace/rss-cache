  "content_html": "<div class=\"twitter-embed\" data-attrs=\"{&quot;url&quot;:&quot;https://x.com/ap/status/2102851050726117487?s=61&quot;,&quot;full_text&quot;:&quot;BREAKING: Heads of major AI firms warn the UN that without intervention, \\&quot;AI could be a risk to humanity as a whole\\&quot;. &quot;,&quot;username&quot;:&quot;AP&quot;,&quot;name&quot;:&quot;The Associated Press&quot;,&quot;profile_image_url&quot;:&quot;https://pbs.substack.com/profile_images/1736863672029310976/gzIskvxa_normal.jpg&quot;,&quot;date&quot;:&quot;2026-09-23T20:02:14.000Z&quot;,&quot;photos&quot;:[],&quot;quoted_tweet&quot;:{},&quot;reply_count&quot;:99,&quot;retweet_count&quot;:325,&quot;like_count&quot;:598,&quot;impression_count&quot;:62290,&quot;expanded_url&quot;:{&quot;url&quot;:&quot;https://apnews.com/article/ai-artificial-intelligence-un-security-council-64519ea66b38e2600026f4481ad7f211?utm_campaign=trueAnthem%3A+New+Content+%28Feed%29&amp;utm_medium=trueAnthem&amp;utm_source=twitter&quot;,&quot;title&quot;:&quot;Heads of AI firms tell UN Security Council that it could be a risk to all humanity&quot;,&quot;description&quot;:&quot;The heads of major artificial intelligence firms pleaded with the United Nations to set controls over the burgeoning technology they are designing in order to save the world &#8212; or at least its people.&quot;,&quot;domain&quot;:&quot;apnews.com&quot;,&quot;image&quot;:&quot;https://pbs.substack.com/news_img/2102850905729273856/-aZXFKC4?format=jpg&amp;name=orig&quot;},&quot;video_url&quot;:null,&quot;video_preview_media_key&quot;:null,&quot;belowTheFold&quot;:false}\" data-component-name=\"Twitter2ToDOM\"></div><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!wF_v!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2Fbb482897-8a49-42d3-b094-88a7ecd72716_1594x829.png\" data-compon