post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2bdf2fb2-9777-4c75-aae3-79c123b69d7b_1298x1017.jpeg 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button><button class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button></div></div></div></a></figure></div><p>Both assumed revenue would go up and up.</p><p>That brings me to Part II.</p><h1>Part II: Misconceptions</h1><p>The first misconception was that revenue would continue to grow exponentially. I have often called that the trillion-pound baby fallacy, after this memorable tweet.</p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!eMnn!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!eMnn!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 424w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 848w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 1456w\" sizes=\"auto, 100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!eMnn!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg\" width=\"1152\" height=\"1310\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1310,&quot;width&quot;:1152,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:270896,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://garymarcus.substack.com/i/225508496?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!eMnn!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 424w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 848w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!eMnn!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F98f9a9fc-26b2-4c1e-a463-0e39a4c48708_1152x1310.jpeg 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button><button class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button></div></div></div></a></figure></div><p>The point was that few exponentials last forever. And, sure enough, Anthropic has already fallen off Q2&#8217;s revenue rocket:</p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!pa6N!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1f3f8db5-2f84-4737-8e21-2c609a82ac6f_1418x956.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!pa6N!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1f3f8db5-2f84-4737-8e21-2c609a82ac6f_1418x956.jpeg 424w, https://substackcdn.com/image/fetch/$s_!pa6N!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1f3f8db5-2f84-4737-8e21-2c609a82ac6f_1418x956.jpeg 848w, https://substackcdn.com/image/fetch/$s_!pa6N!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F1f3f8db5-2f84-4737-8e21-2c609a82ac6f_1418x956.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!pa6N!,w_1456,c_lim