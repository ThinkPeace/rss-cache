78575-fc16-4f41-9e7a-db44a736978e_1394x1809.png&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!c77-!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F24f78575-fc16-4f41-9e7a-db44a736978e_1394x1809.png 424w, https://substackcdn.com/image/fetch/$s_!c77-!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F24f78575-fc16-4f41-9e7a-db44a736978e_1394x1809.png 848w, https://substackcdn.com/image/fetch/$s_!c77-!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F24f78575-fc16-4f41-9e7a-db44a736978e_1394x1809.png 1272w, https://substackcdn.com/image/fetch/$s_!c77-!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F24f78575-fc16-4f41-9e7a-db44a736978e_1394x1809.png 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button><button class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button></div></div></div></a></figure></div><p>At this point, I think we can count my &#8220;black swan&#8221; prediction in Politico that we would soon see the largest cyberattack in history as largely correct. (I don&#8217;t quite get the year right, though, to be fair).</p><div class=\"captioned-image-container\"><figure><a class=\"image-link image2 is-viewable-img\" target=\"_blank\" href=\"https://substackcdn.com/image/fetch/$s_!7Kgb!,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg\" data-component-name=\"Image2ToDOM\"><div class=\"image2-inset\"><picture><source type=\"image/webp\" srcset=\"https://substackcdn.com/image/fetch/$s_!7Kgb!,w_424,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 424w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_848,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 848w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_1272,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_1456,c_limit,f_webp,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 1456w\" sizes=\"auto, 100vw\"><img src=\"https://substackcdn.com/image/fetch/$s_!7Kgb!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg\" width=\"1456\" height=\"1878\" data-attrs=\"{&quot;src&quot;:&quot;https://substack-post-media.s3.amazonaws.com/public/images/2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg&quot;,&quot;srcNoWatermark&quot;:null,&quot;fullscreen&quot;:null,&quot;imageSize&quot;:null,&quot;height&quot;:1878,&quot;width&quot;:1456,&quot;resizeWidth&quot;:null,&quot;bytes&quot;:619730,&quot;alt&quot;:null,&quot;title&quot;:null,&quot;type&quot;:&quot;image/jpeg&quot;,&quot;href&quot;:null,&quot;belowTheFold&quot;:true,&quot;topImage&quot;:false,&quot;internalRedirect&quot;:&quot;https://garymarcus.substack.com/i/225343416?img=https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg&quot;,&quot;isProcessing&quot;:false,&quot;align&quot;:null,&quot;offset&quot;:false}\" class=\"sizing-normal\" alt=\"\" srcset=\"https://substackcdn.com/image/fetch/$s_!7Kgb!,w_424,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 424w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_848,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 848w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_1272,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 1272w, https://substackcdn.com/image/fetch/$s_!7Kgb!,w_1456,c_limit,f_auto,q_auto:good,fl_progressive:steep/https%3A%2F%2Fsubstack-post-media.s3.amazonaws.com%2Fpublic%2Fimages%2F2955706d-f41a-4aa8-99c3-ed6c16b97ec7_1668x2152.jpeg 1456w\" sizes=\"auto, 100vw\" loading=\"lazy\"></picture><div class=\"image-link-expand\"><div class=\"pencraft pc-display-flex pc-gap-8 pc-reset\"><button class=\"pencraft pc-reset pencraft icon-container restack-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button><button class=\"pencraft pc-reset pencraft icon-container view-image buttonBase-tqxFUX\" tabindex=\"0\" type=\"button\"></button></div></div></div></a></figure></div><p>I see at least three key vectors in the rise of cybersecurity and infrastructure isses (all of which I have warned about here repeatedly):</p><p>First, vibe coding is a recipe for disaster. Some of  what we are seeing is probably a function of vulnerable code written by people who lack sufficient experience to understand the messes they are getting themselves into. (As the always-wise security expert Dr. Heidy Khlaaf points out, the widespread adoption of vibe coding itself  &#8220;<a href=\"https://x.com/heidykhlaaf/status/2122672152679956749?a=bNvlWikJeS7k0zTIRSM&amp;s=61\">is a symptom of poor industry practices we&#8217;ve witnessed over the last decade</a>&#8221;).</p><p>Second, AI agents with unrestricted internet access can easily cause considerable harm. They are poor at following instructions, and, as the OpenAI/Hugging Face incident (and many others) revealed, they have no moral compass. Agents just do stuff, without regard to consequences. And while &#8220;most&#8221; of these incidents may be harmless, as OpenAI once said, some of them are not.</p><p>Third, because current AI really doesn&#8217;t have a larger picture about the consequences of what it can do, bad actors can readily exploit it. My guess is that both state actors and criminal syndicates are exploring the limits of what can be done as quickly as possible, and at least for now attackers may have an advantage over defenders. (How much is malice and how much is incompetence, we don&#8217;t really know.)</p><p>&#167;</p><p>It&#8217;s great that California <a href=\"https://nypost.com/2026/11/16/us-news/california-sues-openai-after-hugging-face-hack-other-incidents/\">just sued OpenAI over possible computer crimes</a>. As I told the California Post yesterday:</p><p>&#8220;<em>California is stepping up where the federal government has fallen short, looking into whether OpenAI&#8217;s poorly-controlled AI has committed computer crimes&#8212;and into whether OpenAI may have tried to hide the facts. Good for Rob Bonta for standing up for humanity and pushing OpenAI to reveal the full story.</em>&#8221;</p><p>All this is going to get much worse until the federal government steps up, too.</p><div class=\"subscription-widget-wrap-editor\" data-attrs=\"{&quot;url&quot;:&quot;https://garymarcus.substack.com/subscribe?&quot;,&quot;text&quot;:&quot;Subscribe&quot;,&quot;language&quot;:&quot;en&quot;}\" data-component-name=\"SubscribeWidgetToDOM\"><div class=\"subscription-widget show-subscribe\"><div class=\"preamble\"><p class=\"cta-caption\">I tend not to paywall essays like this that I write as public service announcements, but I would still appreciate your subscriptions, whether paid or free.</p></div><form class=\"subscription-widget-subscribe\"><input type=\"email\" class=\"email-input\" name=\"email\" placeholder=\"Type your email&#8230;\" tabindex=\"-1\"><input type=\"submit\" class=\"button primary\" value=\"Subscribe\"><div class=\"fake-input-wrapper\"><div class=\"fake-input\"></div><div class=\"fake-button\"></div></div></form></div></div><p></p><div class=\"twitter-embed\" data-attrs=\"{&quot;url&quot;:&quot;https://x.com/garymarcus/status/2121379488248533458?a=R25f9rrwNKcEAlNvzvQ&amp;s=61&quot;,&quot;full_text&quot;:&quot;i wonder if every alien civilization goes through an LLM phase where they wreck their civilization.\\n\\nand whether any make it out through to the other side.&quot;,&quot;username&quot;:&quot;GaryMarcus&quot;,&quot;name&quot;:&quot;Gary Marcus&quot;,&quot;profile_image_url&quot;:&quot;https://pbs.substack.com/profile_images/2048405471900606464/kPeRHI2z_normal.jpg&quot;,&quot;date&quot;:&quot;2026-11-13T23:07:37.000Z&quot;,&quot;photos&quot;:[],&quot;quoted_tweet&quot;:{},&quot;reply_count&quot;:62,&quot;retweet_count&quot;:44,&quot;like_count&quot;:533,&quot;impression_count&quot;:20774,&quot;expanded_url&quot;:null,&quot;video_url&quot;:null,&quot;video_preview_media_key&quot;:null,&quot;belowTheFold&quot;:true}\" data-component-name=\"Twitter2ToDOM\"></div><p></p>",
